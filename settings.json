{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "autoCompactEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(dotnet *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(gh *)",
      "Bash(pwsh *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(pip *)",
      "Bash(python *)",
      "Bash(ruby *)",
      "Bash(bundle *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(**/*.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*credentials*)",
      "Read(**/.ssh/*)",
      "Read(**/*secret*)",
      "Edit(**/*.env)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/*credentials*)",
      "Edit(**/.ssh/*)",
      "Edit(**/*secret*)",
      "Write(**/*.env)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Write(**/*credentials*)",
      "Write(**/.ssh/*)",
      "Write(**/*secret*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen",
  "env": {
    "FORCE_HYPERLINK": "1",
    "EDITOR": "vim"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Itenium-ing",
      "Over-engineering",
      "Bikeshedding",
      "Summoning Skynet",
      "Reticulating splines",
      "Blaming the intern",
      "Consulting the rubber duck"
    ]
  },
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "CVE-(?<cve>\\d{4}-\\d+)",
      "url": "https://nvd.nist.gov/vuln/detail/CVE-{cve}",
      "label": "CVE-{cve}"
    }
  ],
  "companyAnnouncements": [
    "itenium AI Extending your Agent, like a champ"
  ],
  "spinnerTipsOverride": {
    "tips": [
      "💡 itenium tip: the description IS the interface"
    ]
  }
}
