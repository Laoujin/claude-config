# Reference .editorconfig for .NET projects
# Generate a project-specific base with: dotnet new editorconfig
# Then apply these overrides.

root = true

[*.cs]

#### Overrides from default template ####

# Use file-scoped namespaces (default template uses block_scoped)
csharp_style_namespace_declarations = file_scoped:warning

# Use var when type is apparent from RHS
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Sort System usings first (default is false)
dotnet_sort_system_directives_first = true

#### Code style ####

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_braces = true:suggestion

dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_code_quality_unused_parameters = all:warning

#### Naming: private fields must use _camelCase (not in default template) ####

dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal, private_protected

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

#### Naming: raise default severity from suggestion to warning ####

dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = warning

#### Analyzers ####

dotnet_diagnostic.CA1502.severity = warning    # Cyclomatic complexity
dotnet_analyzer_diagnostic.category-roslynator.severity = suggestion
dotnet_diagnostic.RCS1018.severity = warning   # Add accessibility modifiers
dotnet_diagnostic.RCS1077.severity = warning   # Optimize LINQ method call
dotnet_diagnostic.RCS1198.severity = warning   # Avoid unnecessary boxing
